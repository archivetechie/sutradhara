[Unit]
Description=Export and ship the Sutradhara retention evidence journal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=replica
Group=replica
WorkingDirectory=/opt/sutradhara
EnvironmentFile=-/etc/sutradhara/sutradhara.env
ExecStart=/opt/sutradhara/.venv/bin/sutra retention journal export
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
